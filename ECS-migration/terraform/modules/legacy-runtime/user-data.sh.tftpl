#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq awscli python3 python3-venv python3-pip nginx unzip curl
mkdir -p /opt/flask-app /var/log/flask-app
aws s3 cp 's3://${bucket}/${key}' /tmp/app.zip --region '${region}'
unzip -q /tmp/app.zip -d /opt/flask-app
chown -R ubuntu:ubuntu /opt/flask-app /var/log/flask-app
# The packaged service selects memory; no RDS credentials are used by legacy.
bash /opt/flask-app/scripts/setup.sh
curl --fail --retry 12 --retry-connrefused --retry-delay 5 http://localhost/ready
